NODE_ENV=development
PORT=5050
MONGODB_URI=
CORS_ORIGIN=
# Set to 1 (hops) or true when behind a reverse proxy / load balancer
TRUST_PROXY=false

# Web app URL, used in email links
APP_URL=http://localhost:5173

# --- Access tokens (RS256) ---
# Generate with: npm run keys:generate   (required in production; dev uses an ephemeral key if unset)
JWT_KEY_ID=
JWT_PRIVATE_KEY=
# JSON array of retired public keys still accepted during rotation: [{"kid":"...","publicKey":"-----BEGIN PUBLIC KEY-----\n..."}]
JWT_PREVIOUS_PUBLIC_KEYS=
JWT_ISSUER=
JWT_AUDIENCE=
ACCESS_TOKEN_TTL_SECONDS=

# --- Sessions ---
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_REUSE_GRACE_SECONDS=20
# Defaults to true in production. Browsers treat http://localhost as secure, so dev usually works either way.
# COOKIE_SECURE=false

# --- Account security ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# --- Email (required in production; in development, emails are printed to the console if unset) ---
SMTP_URL=
MAIL_FROM=

# --- Super Admin bootstrap (npm run iam:bootstrap-super-admin) ---
# Supply via your secret store at run time, or omit to be prompted. Never commit real values.
# BOOTSTRAP_SUPER_ADMIN_EMAIL=
# BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=
# BOOTSTRAP_SUPER_ADMIN_LAST_NAME=
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# --- SMS for guardian OTP (console prints messages; development only) ---
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
DEFAULT_PHONE_COUNTRY_CODE=91

# --- Guardian OTP policy ---
# Random secret, at least 32 characters (required in production): openssl rand -base64 48
OTP_SECRET=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_REQUESTS_PER_DAY=10

# --- ImageKit (student photographs) ---
# Enable "Restrict unsigned image URLs" in the ImageKit dashboard: photos are uploaded as private files
# and only delivered through short-lived signed URLs.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_ROOT_FOLDER=/lekho
IMAGEKIT_SIGNED_URL_TTL_SECONDS=3600
# delete | retain: what happens to replaced or removed photos
STUDENT_PHOTO_RETENTION=delete
